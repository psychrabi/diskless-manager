{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "diskless-manager",
  "version": "1.0.0",
  "identifier": "com.diskless.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Diskless Manager",
        "width": 1680,
        "height": 1050,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src 'self' http://localhost:8080 ws://localhost:8080 http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "linux": {
      "deb": {
        "files": {},
        "depends": [
          "isc-dhcp-server",
          "tftpd-hpa",
          "samba",
          "apache2",
          "wakeonlan",
          "targetcli-fb",
          "zfsutils-linux"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
