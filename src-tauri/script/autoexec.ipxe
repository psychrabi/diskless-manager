#!ipxe
# Common diskless-manager dispatcher.
# Per-client boot policy is generated under clients/<12-hex-mac>.ipxe.

set dhcp-timeout 5000
set dhcp-max-retries 3
dhcp || goto failed

# Packaged fallback for the production default HTTP port (80).
# Runtime generation always uses the configured HTTP port.
set boot-url http://${next-server}
set client-mac ${net0/mac:hexraw}

echo Diskless Manager client MAC: ${net0/mac}
echo Loading ${boot-url}/clients/${client-mac}.ipxe
chain ${boot-url}/clients/${client-mac}.ipxe || goto unknown_client

:unknown_client
echo No generated client menu exists for ${net0/mac}.
echo Expected: clients/${client-mac}.ipxe
shell

:failed
echo DHCP failed; cannot locate the diskless-manager boot server.
shell
