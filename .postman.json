  "sample_requests": {
    "authentication_flow": [
      {
        "step": 1,
        "description": "Check if admin exists",
        "request": "GET {{base_url}}/api/auth/admin/exists"
      },
      {
        "step": 2,
        "description": "Login to get JWT token",
        "request": "POST {{base_url}}/api/auth/login",
        "body": {
          "username": "admin",
          "password": "{{admin_password}}"
        }
      },
      {
        "step": 3,
        "description": "Use token for authenticated requests",
        "headers": {
          "Authorization": "Bearer {{auth_token}}"
        }
      }
    ],
    "client_operations": [
      {
        "description": "List all clients",
        "request": "GET {{base_url}}/api/clients",
        "headers": {"Authorization": "Bearer {{auth_token}}"}
      },
      {
        "description": "Create new client",
        "request": "POST {{base_url}}/api/clients",
        "headers": {"Authorization": "Bearer {{auth_token}}", "Content-Type": "application/json"},
        "body": {
          "name": "test-client",
          "mac": "00:11:22:33:44:55",
          "ip": "192.168.1.100",
          "master": "ubuntu-desktop"
        }
      }
    ],
    "service_operations": [
      {
        "description": "Get DHCP service status",
        "request": "GET {{base_url}}/api/services/dhcp/status",
        "headers": {"Authorization": "Bearer {{auth_token}}"}
      },
      {
        "description": "Start TFTP service",
        "request": "POST {{base_url}}/api/services/tftp/start",
        "headers": {"Authorization": "Bearer {{auth_token}}"}
      }
    ]
  },
